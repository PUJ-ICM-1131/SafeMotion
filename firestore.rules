rules_version = '2';

// Reglas de Cloud Firestore de SafeMotion.
// Se publican en la consola de Firebase: Firestore Database > Reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Perfil de cada usuario. Cualquier usuario autenticado puede leerlo para encontrar
    // a sus contactos por teléfono, pero solo el dueño lo puede escribir.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Invitaciones a ser guardián: solo las ven quien la envía y quien la recibe.
    match /invitations/{invitationId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'PENDING';

      // Quien envía puede reenviarla; quien la recibe solo puede cambiar su respuesta.
      allow update: if signedIn() && (
        (resource.data.fromUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt']))
        || (resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']))
      );

      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Recorridos en tiempo real: los ve el corredor y los guardianes que eligió al iniciar.
    // Solo el corredor crea y actualiza su sesión.
    match /sessions/{sessionId} {
      allow read: if signedIn()
        && (resource.data.runnerUid == request.auth.uid
          || request.auth.uid in resource.data.guardianUids);

      allow create: if signedIn() && request.resource.data.runnerUid == request.auth.uid;

      allow update: if signedIn()
        && resource.data.runnerUid == request.auth.uid
        && request.resource.data.runnerUid == request.auth.uid;

      allow delete: if signedIn() && resource.data.runnerUid == request.auth.uid;

      // Trazado del recorrido: mismos permisos que la sesión a la que pertenece.
      match /points/{pointId} {
        function session() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
        }

        allow read: if signedIn()
          && (session().runnerUid == request.auth.uid
            || request.auth.uid in session().guardianUids);

        allow write: if signedIn() && session().runnerUid == request.auth.uid;
      }
    }

    // Alertas de caída o inactividad: las crea el corredor y las leen él y sus guardianes.
    match /alerts/{alertId} {
      allow read: if signedIn()
        && (resource.data.runnerUid == request.auth.uid
          || request.auth.uid in resource.data.guardianUids);

      allow create: if signedIn() && request.resource.data.runnerUid == request.auth.uid;

      allow update, delete: if signedIn() && resource.data.runnerUid == request.auth.uid;
    }
  }
}
